# Copy to $DEPLOY_PATH/.env on the server and fill in real values. Never commit the real file.
DB_NAME=bloom_school_db
DB_USERNAME=bloom
DB_PASSWORD=change-me-to-a-long-random-password

# Comma-separated frontend origins allowed to call the API (patterns like http://localhost:* work)
CORS_ALLOWED_ORIGINS=http://localhost:*,https://your-frontend-domain.com

# Host port the API is published on
BACKEND_PORT=9090

# Set automatically by the deploy workflow; only edit for manual rollbacks
BACKEND_IMAGE=ghcr.io/douglaskhembo/bloombackend:latest
